// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String?
  password  String
  role      Role    @default(SELLER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coordinator Coordinator?
  seller      Seller?
  notifications Notification[]
  auditLogs   AuditLog[]

  @@index([email])
  @@index([role])
}

enum Role {
  ADMIN
  COORDINATOR
  SELLER
}

model Region {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  code      String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coordinators CoordinatorRegion[]
  companies    Company[]
  orders       Order[]
  forecasts    Forecast[]

  @@index([code])
}

model Coordinator {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  regions   CoordinatorRegion[]
  sellers   Seller[]
  companies Company[]
  orders    Order[]
  forecasts Forecast[]

  @@index([userId])
}

model CoordinatorRegion {
  id            Int @id @default(autoincrement())
  coordinatorId Int
  regionId      Int
  createdAt     DateTime @default(now())

  coordinator Coordinator @relation(fields: [coordinatorId], references: [id], onDelete: Cascade)
  region      Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([coordinatorId, regionId])
  @@index([coordinatorId])
  @@index([regionId])
}

model Seller {
  id            Int @id @default(autoincrement())
  userId        Int @unique
  coordinatorId Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  coordinator Coordinator @relation(fields: [coordinatorId], references: [id], onDelete: Cascade)
  companies   Company[]
  orders      Order[]
  forecasts   Forecast[]

  @@index([userId])
  @@index([coordinatorId])
}

model Company {
  id            Int     @id @default(autoincrement())
  name          String
  cnpj          String? @unique
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  regionId      Int
  sellerId      Int
  coordinatorId Int
  status        CompanyStatus @default(PROSPECT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  region      Region @relation(fields: [regionId], references: [id])
  seller      Seller @relation(fields: [sellerId], references: [id])
  coordinator Coordinator @relation(fields: [coordinatorId], references: [id])
  orders      Order[]
  forecasts   Forecast[]

  @@index([regionId])
  @@index([sellerId])
  @@index([coordinatorId])
  @@index([cnpj])
  @@index([status])
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  sku         String  @unique
  price       Int     // in cents
  category    String?
  stock       Int     @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([sku])
  @@index([category])
  @@index([active])
}

model Order {
  id            Int     @id @default(autoincrement())
  orderNumber   String  @unique
  companyId     Int
  sellerId      Int
  coordinatorId Int
  regionId      Int
  totalAmount   Int     // in cents
  status        OrderStatus @default(PENDING)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company @relation(fields: [companyId], references: [id])
  seller      Seller @relation(fields: [sellerId], references: [id])
  coordinator Coordinator @relation(fields: [coordinatorId], references: [id])
  region      Region @relation(fields: [regionId], references: [id])
  items       OrderItem[]

  @@index([companyId])
  @@index([sellerId])
  @@index([coordinatorId])
  @@index([regionId])
  @@index([status])
  @@index([orderNumber])
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Int // in cents
  totalPrice Int // in cents
  createdAt DateTime @default(now())

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Notification {
  id              Int     @id @default(autoincrement())
  userId          Int
  type            NotificationType
  title           String
  content         String?
  read            Boolean @default(false)
  relatedEntityId Int?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  COMPANY_CREATED
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  COORDINATOR_ASSIGNED
}

model Forecast {
  id                Int @id @default(autoincrement())
  companyId         Int
  sellerId          Int
  coordinatorId     Int
  regionId          Int
  forecastedAmount  Int // in cents
  month             Int // 1-12
  year              Int
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company     Company @relation(fields: [companyId], references: [id])
  seller      Seller @relation(fields: [sellerId], references: [id])
  coordinator Coordinator @relation(fields: [coordinatorId], references: [id])
  region      Region @relation(fields: [regionId], references: [id])

  @@unique([companyId, month, year])
  @@index([companyId])
  @@index([sellerId])
  @@index([coordinatorId])
  @@index([regionId])
  @@index([month, year])
}

model AuditLog {
  id         Int     @id @default(autoincrement())
  userId     Int
  action     String
  entityType String
  entityId   Int?
  changes    String? // JSON string
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
}

